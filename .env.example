# Required for /api/send-otp
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: use a verified domain sender in production.
# The default onboarding@resend.dev sender only works for Resend's test recipient.
RESEND_FROM_EMAIL=Univo <onboarding@resend.dev>
# Public URL used by friend-request email buttons.
APP_URL=https://univo.shikharthisside.in
ACCESS_APPROVAL_EMAIL=inform.shikhar@gmail.com
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://univo.shikharthisside.in/api/auth/google/callback

# Optional: stable signing secret for OTP verification.
OTP_SECRET=replace-with-a-long-random-secret
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
